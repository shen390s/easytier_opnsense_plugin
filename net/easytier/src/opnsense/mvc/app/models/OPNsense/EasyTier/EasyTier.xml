<model>
    <mount>//OPNsense/EasyTier</mount>
    <description>EasyTier P2P overlay network configuration</description>
    <version>1.0.0</version>
    <items>
        <general>
            <enabled type="BooleanField">
                <default>0</default>
                <Required>Y</Required>
            </enabled>
            <network_name type="TextField">
                <Required>N</Required>
            </network_name>
            <network_secret type="TextField">
                <Required>N</Required>
            </network_secret>
            <hostname type="TextField">
                <Required>N</Required>
            </hostname>
            <ipv4 type="TextField">
                <Required>N</Required>
            </ipv4>
            <dhcp type="BooleanField">
                <default>0</default>
                <Required>N</Required>
            </dhcp>
            <default_protocol type="OptionField">
                <Required>N</Required>
                <default></default>
                <BlankDesc>Nothing selected</BlankDesc>
                <OptionValues>
                    <udp>UDP</udp>
                    <tcp>TCP</tcp>
                    <ws>WebSocket</ws>
                    <wss>WebSocket Secure</wss>
                </OptionValues>
            </default_protocol>
            <listeners type="TextField">
                <Required>N</Required>
            </listeners>
            <peers type="TextField">
                <Required>N</Required>
            </peers>
            <proxy_networks type="TextField">
                <Required>N</Required>
            </proxy_networks>
            <rpc_portal type="TextField">
                <Required>N</Required>
            </rpc_portal>
            <external_node type="TextField">
                <Required>N</Required>
            </external_node>
            <relay_all_peer_rpc type="BooleanField">
                <default>0</default>
                <Required>N</Required>
            </relay_all_peer_rpc>
            <relay_network_whitelist type="TextField">
                <Required>N</Required>
            </relay_network_whitelist>
            <disable_p2p type="BooleanField">
                <default>0</default>
                <Required>N</Required>
            </disable_p2p>
            <disable_udp_hole_punching type="BooleanField">
                <default>0</default>
                <Required>N</Required>
            </disable_udp_hole_punching>
            <multi_thread type="BooleanField">
                <default>0</default>
                <Required>N</Required>
            </multi_thread>
            <latency_first type="BooleanField">
                <default>0</default>
                <Required>N</Required>
            </latency_first>
            <enable_exit_node type="BooleanField">
                <default>0</default>
                <Required>N</Required>
            </enable_exit_node>
            <no_tun type="BooleanField">
                <default>0</default>
                <Required>N</Required>
            </no_tun>
            <socks5_portal type="TextField">
                <Required>N</Required>
            </socks5_portal>
        </general>
    </items>
</model>
