<model>
    <mount>//OPNsense/EasyTier</mount>
    <description>EasyTier P2P overlay network configuration</description>
    <version>1.0.0</version>
    <items>
        <general>
            <enabled type="BooleanField">
                <default>0</default>
                <Required>Y</Required>
            </enabled>
            <network_name type="TextField">
                <default></default>
                <Required>N</Required>
                <mask>/^[a-zA-Z0-9_\-\.]{0,64}$/</mask>
                <ValidationMessage>Please enter a valid network name (alphanumeric, dashes, underscores, dots, max 64 chars)</ValidationMessage>
            </network_name>
            <network_secret type="TextField">
                <default></default>
                <Required>N</Required>
                <mask>/^.{0,128}$/</mask>
                <ValidationMessage>Please enter a network secret (max 128 chars)</ValidationMessage>
            </network_secret>
            <hostname type="TextField">
                <default></default>
                <Required>N</Required>
                <mask>/^[a-zA-Z0-9_\-\.]{0,64}$/</mask>
                <ValidationMessage>Please enter a valid hostname</ValidationMessage>
            </hostname>
            <ipv4 type="TextField">
                <default></default>
                <Required>N</Required>
                <mask>/^([0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}(\/[0-9]{1,2})?)?$/</mask>
                <ValidationMessage>Enter a valid IPv4 address with optional CIDR (e.g., 10.144.144.1/24)</ValidationMessage>
            </ipv4>
            <dhcp type="BooleanField">
                <default>0</default>
                <Required>N</Required>
            </dhcp>
            <default_protocol type="OptionField">
                <default>udp</default>
                <Required>N</Required>
                <BlankDesc>Default (UDP)</BlankDesc>
                <OptionValues>
                    <udp>UDP</udp>
                    <tcp>TCP</tcp>
                    <ws>WebSocket</ws>
                    <wss>WebSocket Secure</wss>
                </OptionValues>
            </default_protocol>
            <listeners type="TextField">
                <default></default>
                <Required>N</Required>
                <ValidationMessage>Enter listeners in format protocol://address:port (comma separated)</ValidationMessage>
            </listeners>
            <peers type="TextField">
                <default></default>
                <Required>N</Required>
                <ValidationMessage>Enter peer URLs in format protocol://address:port (comma separated)</ValidationMessage>
            </peers>
            <proxy_networks type="TextField">
                <default></default>
                <Required>N</Required>
                <ValidationMessage>Enter proxy networks in CIDR format (comma separated)</ValidationMessage>
            </proxy_networks>
            <rpc_portal type="TextField">
                <default>127.0.0.1:15888</default>
                <Required>N</Required>
                <mask>/^([0-9a-fA-F\.\:]+:[0-9]+)?$/</mask>
                <ValidationMessage>Enter address:port for the RPC portal</ValidationMessage>
            </rpc_portal>
            <external_node type="TextField">
                <default></default>
                <Required>N</Required>
                <ValidationMessage>Please enter a valid external node URL</ValidationMessage>
            </external_node>
            <relay_all_peer_rpc type="BooleanField">
                <default>0</default>
                <Required>N</Required>
            </relay_all_peer_rpc>
            <relay_network_whitelist type="TextField">
                <default></default>
                <Required>N</Required>
                <ValidationMessage>Enter network names to allow relaying (comma separated)</ValidationMessage>
            </relay_network_whitelist>
            <disable_p2p type="BooleanField">
                <default>0</default>
                <Required>N</Required>
            </disable_p2p>
            <disable_udp_hole_punching type="BooleanField">
                <default>0</default>
                <Required>N</Required>
            </disable_udp_hole_punching>
            <multi_thread type="BooleanField">
                <default>0</default>
                <Required>N</Required>
            </multi_thread>
            <latency_first type="BooleanField">
                <default>0</default>
                <Required>N</Required>
            </latency_first>
            <enable_exit_node type="BooleanField">
                <default>0</default>
                <Required>N</Required>
            </enable_exit_node>
            <no_tun type="BooleanField">
                <default>0</default>
                <Required>N</Required>
            </no_tun>
            <socks5_portal type="TextField">
                <default></default>
                <Required>N</Required>
                <mask>/^([0-9a-fA-F\.\:]+:[0-9]+)?$/</mask>
                <ValidationMessage>Enter address:port for SOCKS5 portal</ValidationMessage>
            </socks5_portal>
        </general>
    </items>
</model>
